{
  "name": "bookmark-navigator",
  "version": "1.0.2",
  "description": "Bookmark Navigator - Chrome new tab page with categorized bookmarks",
  "scripts": {
    "build:css": "npx tailwindcss -i ./src/styles.css -o ./src/styles.css --minify",
    "build": "npm run build:css",
    "dev": "npx tailwindcss -i ./src/styles.css -o ./src/styles.css --watch"
