    "chrome-extension",
    "bookmarks",
    "tailwindcss"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "sharp": "^0.33.0",
    "tailwindcss": "^3.4.0"
  }
}
